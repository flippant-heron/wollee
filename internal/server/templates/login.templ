package templates

// LoginPage is a standalone full page (not wrapped in Layout) since it has no
// authenticated nav and must render before any auth token exists.
templ LoginPage() {
	<!doctype html>
	<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>wollee - Login</title>
		<link rel="stylesheet" href="/static/blades.min.css"/>
		<link rel="stylesheet" href="/static/app.css"/>
		<link rel="stylesheet" href="/static/material-symbols.css"/>
		<script defer src="/static/alpine.min.js"></script>
		<script src="/static/common.js"></script>
		<style>
			body { display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
			.login-container { width: 100%; max-width: 400px; padding: 1rem; }
			[x-cloak] { display: none !important; }
		</style>
	</head>
	<body>
		<div class="login-container" x-cloak x-data="loginApp()" x-init="$store.theme.init(); initAuth()">
			<article>
				<header>
					<h1>wollee</h1>
					<p>Wake-on-LAN Control</p>
				</header>

				<template x-if="error">
					<p style="color: var(--error-color, #d32f2f); font-weight: 500;" x-text="error"></p>
				</template>

				<form @submit.prevent="handleAuth">
					<h2 x-text="passwordSet ? 'Login' : 'Set Password'"></h2>

					<template x-if="!passwordSet">
						<div>
							<label for="new-pwd">New Password (min 8 chars)</label>
							<input type="password" id="new-pwd" x-model="password" minlength="8" required :disabled="loading"/>
						</div>
					</template>
					<template x-if="!passwordSet">
						<div>
							<label for="confirm-pwd">Confirm Password</label>
							<input type="password" id="confirm-pwd" x-model="confirm" required :disabled="loading"/>
						</div>
						<template x-if="password && confirm && password !== confirm">
							<p style="color: var(--error-color, #d32f2f); font-weight: 500;">Passwords do not match</p>
						</template>
					</template>

					<template x-if="passwordSet">
						<div>
							<label for="login-pwd">Password</label>
							<input type="password" id="login-pwd" x-model="password" required :disabled="loading"/>
						</div>
					</template>

					<button type="submit" :disabled="loading || (!passwordSet && (!password || !confirm || password !== confirm)) || (passwordSet && !password)" :aria-busy="loading">
						<span x-text="loading ? (passwordSet ? 'Logging in...' : 'Setting up...') : (passwordSet ? 'Login' : 'Set Password')"></span>
					</button>
				</form>
			</article>

			<footer style="position: fixed; bottom: 1rem; right: 1rem;">
				<button type="button" class="secondary" @click="$store.theme.toggle()" title="Toggle dark mode" style="padding: 0.5rem; width: 2.5rem; height: 2.5rem;">
					<span class="material-symbols-outlined" x-text="$store.theme.dark ? 'light_mode' : 'dark_mode'"></span>
				</button>
			</footer>
		</div>
	</body>
	</html>
}
