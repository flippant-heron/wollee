package templates

// Layout is the shared page shell (head, nav, article wrapper) used by every
// authenticated full-page (non-HTMX) response so nav/theme/logout behavior is
// identical regardless of which page was loaded directly.
templ Layout(title string) {
	<!doctype html>
	<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } - wollee</title>
		<link rel="stylesheet" href="/static/blades.min.css"/>
		<link rel="stylesheet" href="/static/app.css"/>
		<link rel="stylesheet" href="/static/material-symbols.css"/>
		<script src="/static/htmx.min.js"></script>
		<script defer src="/static/alpine.min.js"></script>
		<script src="/static/common.js"></script>
	</head>
	<body>
		<main class="container" x-data="wolleeApp()" x-init="$store.theme.init()">
			<nav x-data="{ navOpen: false }">
				<ul><li><strong>wollee</strong></li></ul>
				<button type="button" class="nav-toggle" @click="navOpen = !navOpen" title="Toggle menu">
					<span class="material-symbols-outlined sm">menu</span>
				</button>
				<ul :class="{ active: navOpen }">
					<li><button type="button" @click="htmx.trigger('#status-table', 'statusRefresh')" title="Refresh host list">
						<span class="material-symbols-outlined sm">refresh</span>
					</button></li>
					<li><button type="button" @click="reloadConfig()" title="Reload configuration">
						<span class="material-symbols-outlined sm">settings_backup_restore</span>
					</button></li>
					<li><button type="button" hx-get="/settings" hx-target="#article-content" hx-swap="innerHTML" title="Settings">
						<span class="material-symbols-outlined sm">settings</span>
					</button></li>
					<li><button type="button" hx-get="/add-host" hx-target="#article-content" hx-swap="innerHTML" title="Add new host">
						<span class="material-symbols-outlined sm">add_circle</span>
					</button></li>
					<li><button type="button" @click="$store.theme.toggle()" title="Toggle dark mode">
						<span class="material-symbols-outlined sm" x-text="$store.theme.dark ? 'light_mode' : 'dark_mode'"></span>
					</button></li>
					<li><button type="button" @click="logout()" title="Logout">
						<span class="material-symbols-outlined sm">logout</span>
					</button></li>
				</ul>
			</nav>

			<article id="article-content">
				{ children... }
			</article>
		</main>
	</body>
	</html>
}
